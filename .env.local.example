# OPCIONAL — só para servidor.
#
# Rodando local você NÃO precisa deste arquivo: a própria tela do painel pede o
# token na primeira execução e grava em .meta-credentials.json (modo 0600, fora
# do Git). O passo a passo aparece dentro da tela.
#
# Estas variáveis existem para deploy (Vercel, Docker, CI). Quando definidas,
# elas VENCEM sobre o que foi configurado pela tela, e a tela fica só de leitura
# — um formulário web não deve poder sobrescrever o que a plataforma define.

# Token do System User do Business Manager. NÃO expira, desde que você deixe
# desmarcada a caixa "O token expira em 60 dias" ao gerar.
META_ACCESS_TOKEN=

# App Secret do app Meta. Opcional: com ele o cliente assina cada chamada
# (appsecret_proof), obrigatório se "Require App Secret" estiver ligado no app.
META_APP_SECRET=

# Contas do seletor: id:nome, separadas por barra vertical. Id só o número,
# sem o prefixo act_. Se omitido, usa as contas descobertas pela tela.
META_AD_ACCOUNTS=100000000000001:Conta A|200000000000002:Conta B

# Opcional. Padrão v26.0
META_API_VERSION=v26.0

# Libera a gravação de credenciais pela tela em build de produção.
# Só ligue se o painel estiver atrás de autenticação.
# ALLOW_REMOTE_SETTINGS=1
