# OPCIONAL — só para servidor.
#
# Rodando local você NÃO precisa deste arquivo: a própria tela do painel pede o
# token na primeira execução e grava em .meta-credentials.json (modo 0600, fora
# do Git). O passo a passo aparece dentro da tela.
#
# Estas variáveis existem para deploy (Vercel, Docker, CI). O que for salvo pela
# tela vence sobre elas; "Voltar a usar o token do ambiente" desfaz.

# Token do System User do Business Manager. NÃO expira, desde que você deixe
# desmarcada a caixa "O token expira em 60 dias" ao gerar.
META_ACCESS_TOKEN=

# App Secret do app Meta. Opcional: com ele o cliente assina cada chamada
# (appsecret_proof), obrigatório se "Require App Secret" estiver ligado no app.
META_APP_SECRET=

# Contas do seletor: id:nome, separadas por barra vertical. Id só o número,
# sem o prefixo act_. Se omitido, usa as contas descobertas pela tela.
META_AD_ACCOUNTS=100000000000001:Conta A|200000000000002:Conta B

# Opcional. Padrão v26.0
META_API_VERSION=v26.0

# Opcional. Chave do cookie cifrado onde a tela salva o token em serverless.
# Sem ela, a chave é derivada de META_APP_SECRET ou META_ACCESS_TOKEN.
# SETTINGS_SECRET=

# Vendas do WhatsApp (lib/sales.ts). Sem estas duas, o formulário de vendas
# fica desativado e o ROAS volta a ser só o do pixel — o resto do painel
# funciona normalmente.

# URL do projeto Supabase, ex.: https://xxxxx.supabase.co
SUPABASE_URL=

# service_role key do projeto (Settings > API). Tem acesso total à tabela
# whatsapp_sales, que tem RLS ligado sem policies — só esta chave entra.
# NUNCA use a chave anon aqui, e nunca exponha esta ao browser.
SUPABASE_SERVICE_ROLE_KEY=
